{
  "name": "loadtesting-monorepo",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "loadtesting-monorepo",
      "version": "0.1.0",
      "license": "AGPL-3.0-only",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/web": {
      "name": "@loadtesting/web",
      "version": "0.1.0"
    },
    "node_modules/@ankit-silwal/loadtesting": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@loadtesting/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@loadtesting/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/cli": {
      "name": "@ankit-silwal/loadtesting",
      "version": "0.1.0",
      "license": "AGPL-3.0-only",
      "bin": {
        "loadtesting": "dist/index.js"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "packages/core": {
      "name": "@loadtesting/core",
      "version": "0.1.0"
    }
  }
}
